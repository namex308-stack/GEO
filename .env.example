# Supabase (required for auth + billing in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional JWKS (derived from project URL if omitted; unused by app code today)
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# App — production must be public HTTPS (not localhost) for Kashier webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI & scraping (optional — demo mode without these)
GEMINI_API_KEY=
# Optional override (default: gemini-2.0-flash). gemini-1.5-flash is retired.
# GEMINI_MODEL=gemini-2.5-flash
FIRECRAWL_API_KEY=

# Kashier payments (optional)
KASHIER_MERCHANT_ID=
# Optional client-side fallback if server merchant id is unavailable
# NEXT_PUBLIC_KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
# Escape $ as \$ in .env.local
KASHIER_SECRET_KEY=
# Prefer this for webhook HMAC; falls back to SECRET_KEY then API_KEY
KASHIER_WEBHOOK_SECRET=
# Required in production: "test" or "live" (must match merchant dashboard keys)
KASHIER_MODE=test
# Sessions API is IP-whitelisted; local/dev uses hosted checkout by default.
# Set to true only after whitelisting this machine's IP in Kashier dashboard.
# KASHIER_FORCE_SESSION_API=true
# In production, set to true to skip Sessions API and always use HPP:
# KASHIER_SKIP_SESSION_API=true
# Also set the Kashier dashboard webhook URL to:
#   {NEXT_PUBLIC_APP_URL}/api/webhook/kashier

# Upstash Redis rate limiting (required in production — requests denied when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth is configured in the Supabase dashboard (Auth → Providers → Google).
# Do not put Google client secrets in this Next.js app unless you add a custom IdP flow.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend email (optional — weekly AI report delivery)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=ConvAudit <reports@convaudit.com>

# Cron auth for /api/cron/* (required in production)
# CRON_SECRET=

# Automation engine (infrastructure only — keep OFF in production)
# Master switch for /api/cron/automation/* dispatcher. Default: disabled.
# AUTOMATION_ENABLED=false
# When the master switch is on, dry-run is still the default (no side effects).
# Set AUTOMATION_DRY_RUN=false only for intentional live runs.
# AUTOMATION_DRY_RUN=true
# Optional per-job overrides (require AUTOMATION_ENABLED=true):
# AUTOMATION_JOB_WEEKLY_SCAN=true
# AUTOMATION_JOB_MONTHLY_SCAN=true
# AUTOMATION_JOB_COMPETITOR_MONITORING=true
# AUTOMATION_JOB_HEALTH_UPDATES=true
# AUTOMATION_JOB_WEEKLY_REPORTS=true
# AUTOMATION_JOB_AI_ALERTS=true
# Do NOT add /api/cron/automation/* paths to vercel.json until activation.

# Competitor monitor: live crawl is OFF in development by default.
# Production scheduled jobs crawl when NODE_ENV=production.
# Set true only for intentional local crawl tests:
# COMPETITOR_MONITOR_ALLOW_CRAWL=true

# Local tryout: unlock Business features (ignored when NODE_ENV=production)
NEXT_PUBLIC_DEV_UNLOCK_ALL=true

# Supabase Auth redirect URLs to allow in the dashboard:
#   {NEXT_PUBLIC_APP_URL}/auth/callback
#   {NEXT_PUBLIC_APP_URL}/api/oauth/callback  (legacy forwarder)
